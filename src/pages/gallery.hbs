<!DOCTYPE html>
<html lang="{{lang}}">

<head>
  {{> head}}
  <style>
    .example-container {
      border-width: 2px;
      margin-bottom: 5px;
      display: inline-block;
      width: 270px;
      text-decoration: none;
    }

    .example-container:hover {
      text-decoration: none;
    }

    .example-container:active {
      text-decoration: none;
    }

    .example-container:focus {
      text-decoration: none;
    }

    .example-image {
      width: 250px;
      height: 250px !important;
      margin-left: auto;
      margin-right: auto;
      display: block;
      max-width: 100%;
    }

    .example-title {
      font-size: 12pt;
      margin-top: 0px;
      margin-bottom: 0px;
      display: flex;
      align-items: flex-start;
      overflow: hidden;
    }

    .example-title-text {
      min-width: 0;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .beta-badge {
      flex-shrink: 0;
      display: inline-block;
      background: orange;
      color: white;
      font-size: 8pt;
      font-weight: 600;
      line-height: 1.2em;
      height: 1.2em;
      padding: 0 6px;
      margin-left: 4px;
      vertical-align: top;
      border-radius: 0.6em;
    }

    /* The wave examples carry a sentence of description under the title
       rather than a contributor line, so it wraps instead of being clipped. */
    .example-container .example-contributor.example-description {
      white-space: normal;
      line-height: 1.35;
      height: 3.2em;
    }

    .example-contributor {
      font-size: 8pt;
      color: #888;
      margin-top: 0px;
      margin-bottom: 0px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .anchor {
      padding-top: 65px; 
    }
  </style>
</head>

<body>
  {{> navbar}}
  <div class="container">
    <h1>{{t "gallery:galleryPage.title"}}</h1>
    {{t "gallery:galleryPage.description"}}
    
    {{#each waveExamples}}
      <a href="{{url}}" class="thumbnail example-container">
        <img src="{{image}}" alt="{{name}}" class="img-rounded example-image" loading="lazy">
        <div class="caption">
          <p class="example-title"><span class="example-title-text">{{name}}</span></p>
          <p class="example-contributor example-description">{{description}}</p>
        </div>
      </a>
    {{/each}}
    <br>

    {{> footer}}
  </div>

</body>

</html>