<!DOCTYPE html>
<html lang="{{lang}}">

<head>
  {{> head}}
  <style>
    .preview-image {
      width: 100%;
    }

    .thumbnail.right-caption>img {
      float: left;
      margin-right: 9px;
    }

    .thumbnail {
      margin-bottom: 5px;
    }

    .tool-title {
      font-size: 16pt;
      margin-top: 0px;
      margin-bottom: 0px;
    }

    .mode-title {
      font-size: 16pt;
      margin-top: 0px;
      margin-bottom: 0px;
    }

    .wave-category-title {
      font-size: 13pt;
      margin: 18px 0 2px;
    }

    .wave-category-description {
      font-size: 9pt;
      color: #777;
      margin-bottom: 8px;
    }

    .fork-note {
      font-size: 9pt;
      color: #777;
      margin-top: 18px;
    }

    .example-strip {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      justify-content: center;
    }

    .example-strip a {
      width: 150px;
      text-decoration: none;
    }

    .example-strip img {
      width: 100%;
      border-radius: 4px;
      display: block;
    }

    .example-strip .example-name {
      font-size: 8pt;
      color: #555;
      text-align: center;
      margin: 2px 0 0;
    }
  </style>
</head>

<body>
  {{> navbar}}
  <div class="container">
    <div align="center">
      <h1><b><span>{{t "main:waveHomePage.title"}}</span></b></h1>
      <p>
        {{t "main:waveHomePage.description"}}
      </p>
      <p>
        <a href="{{waveUrl}}" target="_blank" class="btn btn-success btn-lg">{{t "main:waveHomePage.launch"}}</a>
      </p>
      <p class="fork-note">
        {{t "main:waveHomePage.rayOpticsNote"}}
        <a href="{{simulatorUrl}}" target="_blank">{{t "main:waveHomePage.launchRayOptics"}}</a>
      </p>
    </div>
    <br>
    <div id="screenshots" class="carousel slide" data-ride="carousel" style="aspect-ratio: 1140/534; max-width: 1140px">
      <ol class="carousel-indicators">
        <li data-target="#screenshots" data-slide-to="0" class="active"></li>
        <li data-target="#screenshots" data-slide-to="1"></li>
        <li data-target="#screenshots" data-slide-to="2"></li>
        <li data-target="#screenshots" data-slide-to="3"></li>
        <li data-target="#screenshots" data-slide-to="4"></li>
      </ol>

      <div class="carousel-inner" role="listbox">
        {{#each carousel}}
          <div class="item{{#if @first}} active{{/if}}">
            <a href="{{url}}" target="_blank"><img src="{{image}}" alt="{{name}}" class="preview-image"></a>
          </div>
        {{/each}}
      </div>

      <a class="left carousel-control" href="#screenshots" role="button" data-slide="prev">
        <span class="glyphicon glyphicon-chevron-left" aria-hidden="true"></span>
        <span class="sr-only">Previous</span>
      </a>
      <a class="right carousel-control" href="#screenshots" role="button" data-slide="next">
        <span class="glyphicon glyphicon-chevron-right" aria-hidden="true"></span>
        <span class="sr-only">Next</span>
      </a>
    </div>

    <div class="row" style="font-size: 10pt">
      <div class="col-sm-6">
        <div class="col-sm-12">
          <h2>{{t "main:waveHomePage.componentsTitle"}}</h2>
          {{#each categories}}
            <h3 class="wave-category-title">{{title}}</h3>
            <p class="wave-category-description">{{description}}</p>
            {{#each tools}}
              <div class="row thumbnail right-caption">
                <img src="{{image}}" alt="{{title}}" class="img-rounded" style="width:100px;height:100px;">
                <div class="caption">
                  <p class="tool-title">{{title}}</p>
                  <span>{{description}}</span>
                </div>
              </div>
            {{/each}}
          {{/each}}
        </div>
      </div>
      <div class="col-sm-6">
        <div class="col-sm-12">
          <h2>{{t "main:waveHomePage.viewsTitle"}}</h2>
          <p style="font-size: 9pt; color: #777">{{t "main:waveHomePage.viewsDescription"}}</p>
          {{#each views}}
            <div class="row thumbnail">
              <div class="caption">
                <p class="mode-title">{{title}}</p>
                <span>{{description}}</span>
              </div>
              <div align="center">
                <div style="aspect-ratio: 680/300; max-width: 510px">
                  <img src="{{image}}" alt="{{title}}" class="img-rounded" style="width:100%">
                </div>
              </div>
            </div>
          {{/each}}
        </div>
      </div>
    </div>

    <h2>{{t "main:waveHomePage.examplesTitle"}}</h2>
    <div class="example-strip">
      {{#each exampleStrip}}
        <a href="{{url}}" target="_blank">
          <img src="{{image}}" alt="{{name}}">
          <p class="example-name">{{name}}</p>
        </a>
      {{/each}}
    </div>
    <p align="center" style="margin-top: 10px">
      <a href="{{galleryUrl}}">{{t "main:waveHomePage.examplesMore"}}</a>
    </p>

    {{> footer}}
  </div>
</body>

</html>
