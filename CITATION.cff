    given-names: Sander
    affiliation: "Delft University of Technology"
version: "1.0.0"
date-released: "2026-09-22"
license: Apache-2.0
repository-code: "https://github.com/ssenhorst/ray-optics"
url: "https://ssenhorst.github.io/ray-optics/"
keywords:
  - optics
  - wave optics
  - diffraction
  - lithography
  - physics education
  - simulation
